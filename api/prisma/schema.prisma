generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  tokenVersion Int       @default(0) @map("token_version")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")

  sessions     Session[]
  ipBans       IpBan[]   @relation("BanCreator")
  settings     PlatformSetting[] @relation("SettingUpdater")
  apiTokens    ApiToken[]

  @@map("users")
}

model Project {
  id                    Int       @id @default(autoincrement())
  name                  String    @unique
  slug                  String    @unique
  containerId           String?   @map("container_id")
  imageId               String?   @map("image_id")
  port                  Int?
  portBlue              Int?      @map("port_blue")
  portGreen             Int?      @map("port_green")
  activeSlot            String    @default("blue") @map("active_slot")
  status                String    @default("building")
  envVars               String?   @map("env_vars")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  previousImageId       String?   @map("previous_image_id")
  previousContainerId   String?   @map("previous_container_id")

  visibility            String    @default("public")
  deployType            String?   @map("deploy_type")
  basicUser             String?   @map("basic_user")
  basicHash             String?   @map("basic_hash")

  healthState           String?   @map("health_state")
  healthStatus          Int?      @map("health_status")
  healthResponseMs      Int?      @map("health_response_ms")
  healthCheckedAt       String?   @map("health_checked_at")
  healthFailures        Int       @default(0) @map("health_failures")
  healthPath            String    @default("/") @map("health_path")

  routePublished        Boolean   @default(false) @map("route_published")
  attestationState      String?   @map("attestation_state")
  attestationCheckedAt  String?   @map("attestation_checked_at")

  lastError             String?   @map("last_error")
  lastErrorStage        String?   @map("last_error_stage")
  lastErrorHint         String?   @map("last_error_hint")
  lastErrorExcerpt      String?   @map("last_error_excerpt")

  repo                  String?
  deployBranch          String    @default("main") @map("deploy_branch")
  isPrimary             Boolean   @default(false) @map("is_primary")

  limitMemoryMb         Int?      @map("limit_memory_mb")
  limitCpu              Float?    @map("limit_cpu")
  limitPids             Int?      @map("limit_pids")
  limitRestartPolicy    String?   @map("limit_restart_policy")
  limitLogMaxSize       String?   @map("limit_log_max_size")
  limitLogMaxFile       Int?      @map("limit_log_max_file")

  githubDeployStatus    String?   @map("github_deploy_status")
  githubDeployDetail    String?   @map("github_deploy_detail")
  githubDeployAt        String?   @map("github_deploy_at")

  isPreview             Boolean   @default(false) @map("is_preview")
  sourceBranch          String?   @map("source_branch")
  pullRequestNumber     Int?      @map("pull_request_number")
  previewExpiresAt      DateTime? @map("preview_expires_at")
  runtime               String?
  nodeId                Int?      @map("node_id")

  deployHistory         DeployHistory[]
  statsHistory          StatsHistory[]
  secrets               Secret[]
  node                  Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([repo])
  @@index([isPrimary])
  @@index([isPreview])
  @@index([nodeId])
  @@map("projects")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  target    String?
  detail    String?
  ip        String?
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at")
  prevHash  String?  @map("prev_hash")
  hash      String?

  @@index([createdAt])
  @@map("audit_log")
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  jti        String   @unique
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model IpBan {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String?
  expiresAt String?  @map("expires_at")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator   User?    @relation("BanCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([ip])
  @@map("ip_bans")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @default(now()) @map("updated_at")

  updater   User?    @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

model DeployHistory {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  imageId     String?  @map("image_id")
  containerId String?  @map("container_id")
  deployedAt  DateTime @default(now()) @map("deployed_at")
  metadata    String?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("deploy_history")
}

model StatsHistory {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  cpuPercent    Float?   @map("cpu_percent")
  memoryMb      Float?   @map("memory_mb")
  memoryLimitMb Float?   @map("memory_limit_mb")
  rxBytes       BigInt?  @map("rx_bytes")
  txBytes       BigInt?  @map("tx_bytes")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
  @@map("stats_history")
}

model Secret {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  key       String
  value     String
  version   Int      @default(1)
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("secrets")
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  scopes     String
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model Node {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  endpoint     String
  role         String    @default("worker")
  status       String    @default("pending")
  lastHealthAt DateTime? @map("last_health_at")
  capacity     String?
  metadata     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  projects     Project[]

  @@map("nodes")
}

// ── V4 Phase 1 — foundational org-scoped model ──────────────────────────────
// New tables live beside the legacy ones; nothing reads them until the owning
// feature flags are enabled. UUID keys (gen_random_uuid()) per the V4 plan.

model Organisation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  adminUsers    AdminUser[]
  adminSessions AdminSession[]

  @@map("organisations")
}

model AdminUser {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  username       String   @unique
  passwordHash   String   @map("password_hash")
  role           String   @default("admin")
  tokenVersion   Int      @default(0) @map("token_version")
  totpSecret     String?  @map("totp_secret")
  totpEnabled    Boolean  @default(false) @map("totp_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  sessions     AdminSession[]

  @@index([organisationId])
  @@map("admin_users")
}

model AdminSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  adminUserId    String   @map("admin_user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  userAgent      String?  @map("user_agent")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  adminUser    AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt(sort: Desc)])
  @@map("admin_sessions")
}

// Org-scoped, entity-addressed, hash-chained audit (canonicalV4 in util/audit).
model AuditLogV4 {
  id             Int      @id @default(autoincrement())
  organisationId String   @map("organisation_id") @db.Uuid
  adminUserId    String?  @map("admin_user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  detail         String?
  ip             String?
  requestId      String?  @map("request_id")
  prevHash       String?  @map("prev_hash")
  hash           String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([organisationId, createdAt(sort: Desc)])
  @@map("audit_log_v4")
}

// ── V4 Phase 2 — Products/Systems data model ────────────────────────────────
// The V4 domain model, created beside the legacy `projects` world. The bridge
// (api/scripts/migrate-projects-to-v4.js) copies projects in; `projects`
// remains the operational source of truth until Phase 3 moves the deploy
// engine. Every table is org-scoped; repository methods must filter on it.

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  slug           String
  status         String   @default("draft")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  systems System[]

  @@unique([organisationId, slug])
  @@index([organisationId, status])
  @@map("products")
}

model System {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  name           String
  slug           String
  systemType     String?  @map("system_type")
  currentStatus  String   @default("unknown") @map("current_status")
  repo           String?
  deployBranch   String   @default("main") @map("deploy_branch")
  isPrimaryRoot  Boolean  @default(false) @map("is_primary_root")
  runtime        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  environments SystemEnvironment[]
  releases     Release[]

  @@unique([organisationId, slug])
  @@index([organisationId, currentStatus])
  @@index([productId])
  @@map("systems")
}

model SystemEnvironment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId   String   @map("organisation_id") @db.Uuid
  systemId         String   @map("system_id") @db.Uuid
  name             String   @default("production")
  accessPolicy     String   @default("public") @map("access_policy")
  healthPath       String   @default("/") @map("health_path")
  routePublished   Boolean  @default(false) @map("route_published")
  // V4 Phase 4 — route publication state machine. route_status is authoritative
  // (inactive/pending/active/failed/superseded); route_published is kept as a
  // legacy mirror (true iff route_status = 'active') for the compat layer.
  routeStatus      String   @default("inactive") @map("route_status")
  routeLastError   String?  @map("route_last_error")
  routeLastPublishedAt DateTime? @map("route_last_published_at")
  basicUser        String?  @map("basic_user")
  basicHash        String?  @map("basic_hash")
  // Current release pointer — plain column, no relation, to avoid an FK cycle
  // with releases.environment_id.
  currentReleaseId String?  @map("current_release_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  system   System              @relation(fields: [systemId], references: [id], onDelete: Cascade)
  releases Release[]
  secrets  EnvironmentSecret[]

  @@unique([systemId, name])
  @@index([organisationId])
  @@map("system_environments")
}

model Release {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  containerId    String?  @map("container_id")
  imageId        String?  @map("image_id")
  port           Int?
  status         String   @default("active")
  deployedAt     DateTime @default(now()) @map("deployed_at")
  metadata       String?

  system      System            @relation(fields: [systemId], references: [id], onDelete: Cascade)
  environment SystemEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, deployedAt(sort: Desc)])
  @@index([systemId, deployedAt(sort: Desc)])
  @@index([organisationId])
  @@map("releases")
}

model Domain {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  hostname       String   @unique
  systemId       String?  @map("system_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  isCustom       Boolean  @default(false) @map("is_custom")
  verified       Boolean  @default(false)
  // V4 Phase 4 — custom-domain verification flow.
  verificationToken     String?   @map("verification_token")
  verificationMethod    String?   @map("verification_method")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verifiedAt            DateTime? @map("verified_at")
  isCanonical           Boolean   @default(false) @map("is_canonical")
  tlsStatus             String?   @map("tls_status")
  lastError             String?   @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@index([systemId])
  @@map("domains")
}

// V4 Phase 4 — explicit domain↔environment routing (junction). One row per
// (environment, domain) pair carrying that route's publication status, so a
// system's environments and custom domains map to routes explicitly rather than
// via the single route_published boolean.
model SystemEnvironmentRoute {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  domainId       String   @map("domain_id") @db.Uuid
  routeStatus    String   @default("inactive") @map("route_status")
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([environmentId, domainId])
  @@index([organisationId, systemId])
  @@index([organisationId, routeStatus])
  @@map("system_environment_routes")
}

// V4 Phase 4 — audit trail of every route publication attempt, so a failed
// Caddy reload/probe is recorded rather than lost.
model RoutePublicationAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  domainId       String?  @map("domain_id") @db.Uuid
  status         String
  error          String?
  attemptedAt    DateTime @default(now()) @map("attempted_at")

  @@index([organisationId, systemId, attemptedAt(sort: Desc)])
  @@map("route_publication_attempts")
}

// V4 Phase 4 — maintenance windows. While an active window covers now(), the
// renderer serves a maintenance response for the environment's routes.
model MaintenanceWindow {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  message        String   @default("This service is temporarily unavailable for maintenance.")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  active         Boolean  @default(true)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId, systemId])
  @@index([organisationId, active, startsAt, endsAt])
  @@map("maintenance_windows")
}

model EnvironmentSecret {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  key            String
  value          String
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  environment SystemEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([organisationId])
  @@map("environment_secrets")
}

model InfrastructureMetric {
  id             Int      @id @default(autoincrement())
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  cpuPercent     Float?   @map("cpu_percent")
  memoryMb       Float?   @map("memory_mb")
  memoryLimitMb  Float?   @map("memory_limit_mb")
  rxBytes        BigInt?  @map("rx_bytes")
  txBytes        BigInt?  @map("tx_bytes")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([systemId, recordedAt(sort: Desc)])
  @@index([organisationId])
  @@map("infrastructure_metrics")
}

model HealthSnapshot {
  id             Int      @id @default(autoincrement())
  organisationId String   @map("organisation_id") @db.Uuid
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String?  @map("environment_id") @db.Uuid
  state          String?
  statusCode     Int?     @map("status_code")
  responseMs     Int?     @map("response_ms")
  checkedAt      DateTime @default(now()) @map("checked_at")

  @@index([systemId, checkedAt(sort: Desc)])
  @@index([organisationId])
  @@map("health_snapshots")
}

model LegacyProjectMap {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  projectId      Int      @unique @map("project_id")
  systemId       String   @map("system_id") @db.Uuid
  environmentId  String   @map("environment_id") @db.Uuid
  releaseId      String?  @map("release_id") @db.Uuid
  domainId       String?  @map("domain_id") @db.Uuid
  migratedAt     DateTime @default(now()) @map("migrated_at")
  notes          String?

  @@index([organisationId])
  @@index([systemId])
  @@map("legacy_project_map")
}

// V4 Phase 0 — minimal job queue. The in-process runner is OFF by default
// (ENABLE_V4_JOBS); Phase 1 adds per-type concurrency limits and dead-letter
// alerting on top of these fields.
model Job {
  id          Int       @id @default(autoincrement())
  jobType     String    @map("job_type")
  payload     String?
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([status, jobType, createdAt])
  @@index([status, nextRunAt])
  @@map("jobs")
}

model BackupRecord {
  id        Int      @id @default(autoincrement())
  stamp     String   @unique
  backend   String   @default("local")
  location  String
  sizeBytes BigInt?  @map("size_bytes")
  manifest  String?
  status    String   @default("completed")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_records")
}

// ── V4 Phase 5 — Portfolio CMS (Tomas) ───────────────────────────────────────
// Draft content for the Acronym public portfolio. Gated by ENABLE_V4_PORTFOLIO
// (already reserved in util/flags.js). Nothing here is served to the public
// directly — the acronym.sk renderer and /api/public/* (Alex, Phase 5) read
// only from PortfolioSnapshot, an immutable versioned blob produced by the
// publish pipeline (api/src/services/portfolioPublish.js). Org-scoped like
// every V4 Phase 2+ table — see api/scripts/lint-org-scoping.js.

model PortfolioPage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  locale         String
  pageType       String   @map("page_type")
  slug           String
  title          String
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  content        String?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([organisationId, locale, slug])
  @@index([organisationId, locale, status])
  @@map("portfolio_pages")
}

model ProductPortfolioProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  locale            String
  title             String
  tagline           String?
  shortDescription  String?  @map("short_description")
  fullDescription   String?  @map("full_description")
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description")
  coverMediaId      String?  @map("cover_media_id") @db.Uuid
  status            String   @default("draft")
  completenessScore Int      @default(0) @map("completeness_score")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([productId, locale])
  @@index([organisationId, locale])
  @@map("product_portfolio_profiles")
}

model PortfolioBlock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  ownerType      String   @map("owner_type")
  ownerId        String   @map("owner_id") @db.Uuid
  locale         String
  blockType      String   @map("block_type")
  position       Int
  data           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([organisationId, ownerType, ownerId, locale])
  @@map("portfolio_blocks")
}

model PortfolioSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  version        Int
  locale         String
  content        String
  contentHash    String   @map("content_hash")
  schemaVersion  String   @map("schema_version")
  publishedBy    String?  @map("published_by") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at")

  @@unique([organisationId, locale, version])
  @@index([organisationId, locale, publishedAt(sort: Desc)])
  @@map("portfolio_snapshots")
}

model PortfolioRedirect {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  locale         String
  fromPath       String   @map("from_path")
  toPath         String   @map("to_path")
  statusCode     Int      @default(301) @map("status_code")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organisationId, locale, fromPath])
  @@map("portfolio_redirects")
}

model PublicForm {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  slug           String
  name           String
  fields         String
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  submissions FormSubmission[]

  @@unique([organisationId, slug])
  @@map("public_forms")
}

model FormSubmission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  data           String
  leadStatus     String   @default("new") @map("lead_status")
  sourceIp       String?  @map("source_ip")
  createdAt      DateTime @default(now()) @map("created_at")

  form PublicForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organisationId, formId, createdAt])
  @@index([organisationId, leadStatus])
  @@map("form_submissions")
}

model MediaAsset {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  storageKey     String   @map("storage_key")
  publicUrl      String?  @map("public_url")
  mediaType      String   @map("media_type")
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt   @map("size_bytes")
  width          Int?
  height         Int?
  status         String   @default("quarantined")
  altText        String?  @map("alt_text")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId, status])
  @@map("media_assets")
}

model LegalVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  locale         String
  docType        String   @map("doc_type")
  version        String
  content        String
  effectiveAt    DateTime @map("effective_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organisationId, locale, docType, version])
  @@map("legal_versions")
}
